{
  "name": "gptworkbot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first coordination for independent ChatGPT Work conversations in one project.",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "docs:sync-homepage": "node scripts/sync-homepage.mjs",
    "docs:check-homepage": "node scripts/sync-homepage.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-extension.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lucide-react": "0.468.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "0.0.310",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.13"
  }
}
